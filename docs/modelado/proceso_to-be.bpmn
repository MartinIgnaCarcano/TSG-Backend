    <bpmn:sequenceFlow id="proc_tobe_f12" sourceRef="proc_tobe_n11" targetRef="proc_tobe_n12" />
    <bpmn:sequenceFlow id="proc_tobe_f13" sourceRef="proc_tobe_n12" targetRef="proc_tobe_n13" />
    <bpmn:sequenceFlow id="proc_tobe_f14" sourceRef="proc_tobe_n13" targetRef="proc_tobe_n14" />
    <bpmn:sequenceFlow id="proc_tobe_f15" sourceRef="proc_tobe_n14" targetRef="proc_tobe_n15" />
    <bpmn:sequenceFlow id="proc_tobe_f16" sourceRef="proc_tobe_n15" targetRef="proc_tobe_n16" />
    <bpmn:sequenceFlow id="proc_tobe_f17" sourceRef="proc_tobe_n16" targetRef="proc_tobe_n17" />
    <bpmn:sequenceFlow id="proc_tobe_f18" sourceRef="proc_tobe_n17" targetRef="proc_tobe_n18" />
    <bpmn:sequenceFlow id="proc_tobe_f19" sourceRef="proc_tobe_n18" targetRef="proc_tobe_n20" />
    <bpmn:sequenceFlow id="proc_tobe_f20" sourceRef="proc_tobe_n8" targetRef="proc_tobe_n19" name="ahorro ≥ umbral" />
  </bpmn:process>
