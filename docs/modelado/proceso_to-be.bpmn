<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://stg.utnfrm/tesis" id="Defs_proc_tobe">
  <bpmn:collaboration id="Collab_proc_tobe">
    <bpmn:participant id="Part_proc_tobe" name="STG — Proceso comercial automatizado (to-be)" processRef="proc_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="proc_tobe" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="l_cli" name="Cliente (WhatsApp)">
        <bpmn:flowNodeRef>proc_tobe_n1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_orq" name="Orquestación (n8n)">
        <bpmn:flowNodeRef>proc_tobe_n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n20</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_sis" name="Persistencia (API + PostgreSQL)">
        <bpmn:flowNodeRef>proc_tobe_n11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_ag" name="Agente de ventas">
        <bpmn:flowNodeRef>proc_tobe_n18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_tobe_n19</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="proc_tobe_n1" name="Mensaje del cliente">
      <bpmn:outgoing>proc_tobe_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="proc_tobe_n2" name="Webhook Twilio
+ validación de firma">
      <bpmn:incoming>proc_tobe_f1</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="proc_tobe_n3" name="Agente LLM: extracción
de entidades">
      <bpmn:incoming>proc_tobe_f2</bpmn:incoming>
      <bpmn:incoming>proc_tobe_f5</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="proc_tobe_n4" name="¿Datos completos?">
      <bpmn:incoming>proc_tobe_f3</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f4</bpmn:outgoing>
      <bpmn:outgoing>proc_tobe_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="proc_tobe_n5" name="Solicitar dato faltante">
      <bpmn:incoming>proc_tobe_f4</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="proc_tobe_n6" name="">
      <bpmn:incoming>proc_tobe_f6</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="proc_tobe_n7" name="Búsqueda tarifaria
(3 variantes de fecha)">
      <bpmn:incoming>proc_tobe_f7</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="proc_tobe_n8" name="Smart Optimizer:
comparativa y mejor precio">
      <bpmn:incoming>proc_tobe_f8</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f9</bpmn:outgoing>
      <bpmn:outgoing>proc_tobe_f20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="proc_tobe_n9" name="Envío de comparativa
(Twilio)">
      <bpmn:incoming>proc_tobe_f9</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="proc_tobe_n10" name="Selección del cliente">
      <bpmn:incoming>proc_tobe_f10</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="proc_tobe_n11" name="Alta de cliente y cotización
(API REST)">
      <bpmn:incoming>proc_tobe_f11</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="proc_tobe_n12" name="Envío de cotización
por correo">
      <bpmn:incoming>proc_tobe_f12</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="proc_tobe_n13" name="Alta de reserva
(máquina de estados)">
      <bpmn:incoming>proc_tobe_f13</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="proc_tobe_n14" name="Registro de pagos
y conciliación de saldo">
      <bpmn:incoming>proc_tobe_f14</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="proc_tobe_n15" name="Generación de voucher
y contrato (Puppeteer)">
      <bpmn:incoming>proc_tobe_f15</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="proc_tobe_n16" name="Cron de recordatorios">
      <bpmn:incoming>proc_tobe_f16</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f17</bpmn:outgoing>
<bpmn:timerEventDefinition id="proc_tobe_n16_td" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="proc_tobe_n17" name="Notificaciones proactivas
(voucher, clima)">
      <bpmn:incoming>proc_tobe_f17</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="proc_tobe_n18" name="Soporte en ruta">
      <bpmn:incoming>proc_tobe_f18</bpmn:incoming>
      <bpmn:outgoing>proc_tobe_f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="proc_tobe_n19" name="Alerta de oportunidad
al equipo comercial">
      <bpmn:incoming>proc_tobe_f20</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:endEvent id="proc_tobe_n20" name="Viaje finalizado">
      <bpmn:incoming>proc_tobe_f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="proc_tobe_f1" sourceRef="proc_tobe_n1" targetRef="proc_tobe_n2" />
    <bpmn:sequenceFlow id="proc_tobe_f2" sourceRef="proc_tobe_n2" targetRef="proc_tobe_n3" />
    <bpmn:sequenceFlow id="proc_tobe_f3" sourceRef="proc_tobe_n3" targetRef="proc_tobe_n4" />
    <bpmn:sequenceFlow id="proc_tobe_f4" sourceRef="proc_tobe_n4" targetRef="proc_tobe_n5" name="no" />
    <bpmn:sequenceFlow id="proc_tobe_f5" sourceRef="proc_tobe_n5" targetRef="proc_tobe_n3" name="nuevo turno" />
    <bpmn:sequenceFlow id="proc_tobe_f6" sourceRef="proc_tobe_n4" targetRef="proc_tobe_n6" name="sí" />
    <bpmn:sequenceFlow id="proc_tobe_f7" sourceRef="proc_tobe_n6" targetRef="proc_tobe_n7" />
    <bpmn:sequenceFlow id="proc_tobe_f8" sourceRef="proc_tobe_n7" targetRef="proc_tobe_n8" />
