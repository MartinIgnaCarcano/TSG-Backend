      <bpmndi:BPMNShape id="proc_asis_n12_di" bpmnElement="proc_asis_n12">
        <dc:Bounds x="2025" y="440" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="proc_asis_n13_di" bpmnElement="proc_asis_n13">
        <dc:Bounds x="2215" y="280" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="proc_asis_n14_di" bpmnElement="proc_asis_n14">
