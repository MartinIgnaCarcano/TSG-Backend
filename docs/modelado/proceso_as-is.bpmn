<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://stg.utnfrm/tesis" id="Defs_proc_asis">
  <bpmn:collaboration id="Collab_proc_asis">
    <bpmn:participant id="Part_proc_asis" name="STG — Proceso comercial actual (as-is)" processRef="proc_asis" />
  </bpmn:collaboration>
  <bpmn:process id="proc_asis" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="lane_cli" name="Cliente">
        <bpmn:flowNodeRef>proc_asis_n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ag" name="Agente de ventas">
        <bpmn:flowNodeRef>proc_asis_n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proc_asis_n14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_prov" name="Proveedor externo">
        <bpmn:flowNodeRef>proc_asis_n12</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="proc_asis_n1" name="Consulta del cliente">
      <bpmn:outgoing>proc_asis_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="proc_asis_n2" name="1. Recepción del lead
(WhatsApp)">
      <bpmn:incoming>proc_asis_f1</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="proc_asis_n3" name="2. Validación de inventario
(portales mayoristas)">
      <bpmn:incoming>proc_asis_f2</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="proc_asis_n4" name="Armado manual de
cotización">
      <bpmn:incoming>proc_asis_f3</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="proc_asis_n5" name="Envío de cotización
(WhatsApp / mail)">
      <bpmn:incoming>proc_asis_f4</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="proc_asis_n6" name="¿Acepta?">
      <bpmn:incoming>proc_asis_f5</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f6</bpmn:outgoing>
      <bpmn:outgoing>proc_asis_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="proc_asis_n7" name="Lead perdido">
      <bpmn:incoming>proc_asis_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="proc_asis_n8" name="3. Gestión de señas y pagos
(transferencia)">
      <bpmn:incoming>proc_asis_f7</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="proc_asis_n9" name="4. Formalización y contrato
(Word / PDF)">
      <bpmn:incoming>proc_asis_f8</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="proc_asis_n10" name="5. Control de vencimientos
y saldos (Excel)">
      <bpmn:incoming>proc_asis_f9</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="proc_asis_n11" name="6. Emisión de documentación
(Word / correo)">
      <bpmn:incoming>proc_asis_f10</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="proc_asis_n12" name="7. Ejecución del servicio">
      <bpmn:incoming>proc_asis_f11</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="proc_asis_n13" name="8. Soporte en ruta
(WhatsApp)">
      <bpmn:incoming>proc_asis_f12</bpmn:incoming>
      <bpmn:outgoing>proc_asis_f13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="proc_asis_n14" name="Viaje finalizado">
      <bpmn:incoming>proc_asis_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="proc_asis_f1" sourceRef="proc_asis_n1" targetRef="proc_asis_n2" />
    <bpmn:sequenceFlow id="proc_asis_f2" sourceRef="proc_asis_n2" targetRef="proc_asis_n3" />
    <bpmn:sequenceFlow id="proc_asis_f3" sourceRef="proc_asis_n3" targetRef="proc_asis_n4" />
    <bpmn:sequenceFlow id="proc_asis_f4" sourceRef="proc_asis_n4" targetRef="proc_asis_n5" />
    <bpmn:sequenceFlow id="proc_asis_f5" sourceRef="proc_asis_n5" targetRef="proc_asis_n6" />
    <bpmn:sequenceFlow id="proc_asis_f6" sourceRef="proc_asis_n6" targetRef="proc_asis_n7" name="no" />
    <bpmn:sequenceFlow id="proc_asis_f7" sourceRef="proc_asis_n6" targetRef="proc_asis_n8" name="sí" />
    <bpmn:sequenceFlow id="proc_asis_f8" sourceRef="proc_asis_n8" targetRef="proc_asis_n9" />
    <bpmn:sequenceFlow id="proc_asis_f9" sourceRef="proc_asis_n9" targetRef="proc_asis_n10" />
    <bpmn:sequenceFlow id="proc_asis_f10" sourceRef="proc_asis_n10" targetRef="proc_asis_n11" />
    <bpmn:sequenceFlow id="proc_asis_f11" sourceRef="proc_asis_n11" targetRef="proc_asis_n12" />
    <bpmn:sequenceFlow id="proc_asis_f12" sourceRef="proc_asis_n12" targetRef="proc_asis_n13" />
    <bpmn:sequenceFlow id="proc_asis_f13" sourceRef="proc_asis_n13" targetRef="proc_asis_n14" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab_proc_asis">
      <bpmndi:BPMNShape id="Part_proc_asis_di" bpmnElement="Part_proc_asis" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="2670" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_cli_di" bpmnElement="lane_cli" isHorizontal="true">
