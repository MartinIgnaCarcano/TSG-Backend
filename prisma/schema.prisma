generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 


// =====================================================
// CLIENTE
// =====================================================
model Cliente {
  id              String   @id @default(cuid())
  numeroCliente   String   @unique @map("numero_cliente")
  nombre          String
  apellido        String
  email           String   @unique
  telefono        String
  cotizaciones    Cotizacion[]
  reservas        Reserva[]
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")
  baja            DateTime? @map("baja")

  @@map("clientes")
}

// =====================================================
// DESTINO
// =====================================================
model Destino {
  id              String   @id @default(cuid())
  nombre          String
  codigoIATA      String   @unique @map("codigo_iata")
  pais            String
  timezone        String   @default("UTC") // ej: "America/Argentina/Buenos_Aires"
  // Relaciones inversas
  tramosOrigen    Tramo[]  @relation("TramoOrigen")
  tramosDestino   Tramo[]  @relation("TramoDestino")
  viajesTorigen   Viaje[]  @relation("ViajeOrigen")
  viajesToDestino Viaje[]  @relation("ViajeDestino")
  hoteles         Hotel[]
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")
  baja            DateTime? @map("baja")

  @@map("destinos")
}

// =====================================================
// HOTEL — catálogo del admin, opcionalmente populado por Flujo 6
// =====================================================
model Hotel {
  id              String   @id @default(cuid())
  nombre          String
  destinoId       String   @map("destino_id")
  destino         Destino  @relation(fields: [destinoId], references: [id])
  estrellas       Int      @default(3) // 1..5
  precioNoche     Decimal  @db.Decimal(10, 2) @map("precio_noche") // USD
  moneda          String   @default("USD")
  descripcion     String?
  direccion       String?
  urlImagen       String?  @map("url_imagen")
  urlReserva      String?  @map("url_reserva") // link a Booking u origen
  fuente          String   @default("MANUAL") // MANUAL | BOOKING | RAPIDAPI
  rating          Decimal? @db.Decimal(3, 1) // ej: 8.7 sobre 10
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")
  baja            DateTime? @map("baja")
  cotizaciones    Cotizacion[]

  @@index([destinoId, baja])
  @@map("hoteles")
}

// =====================================================
// VIAJE
// =====================================================
model Viaje {
  id              String   @id @default(cuid())
  origenId        String   @map("origen_id")
  origen          Destino  @relation("ViajeOrigen", fields: [origenId], references: [id])
  destinoId       String   @map("destino_id")
  destino         Destino  @relation("ViajeDestino", fields: [destinoId], references: [id])
  tieneEscalas    Boolean  @map("tiene_escalas")
  descripcion     String?
  tramos          Tramo[]
  cotizaciones    Cotizacion[]
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")
  baja            DateTime? @map("baja")

  @@map("viajes")
}

// =====================================================
// TRAMO
// =====================================================
model Tramo {
  id              String   @id @default(cuid())
  viajeId         String   @map("viaje_id")
  viaje           Viaje    @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  origenId        String   @map("origen_id")
  origen          Destino  @relation("TramoOrigen", fields: [origenId], references: [id])
  destinoId       String   @map("destino_id")
  destino         Destino  @relation("TramoDestino", fields: [destinoId], references: [id])
  completo        Boolean  @default(false)
  orden           Int?
  duracionMinutos Int?     @map("duracion_minutos")
  horaSalida      DateTime? @map("hora_salida") // UTC timestamp
  horaLlegada     DateTime? @map("hora_llegada") // UTC timestamp
  aerolinea       String?
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")
  baja            DateTime? @map("baja")

  @@map("tramos")
}

// =====================================================
// COTIZACION
// =====================================================
model Cotizacion {
  id              String   @id @default(cuid())
  viajeId         String   @map("viaje_id")
  viaje           Viaje    @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  clienteId       String   @map("cliente_id")
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  numeroCotizacion String  @unique @map("numero_cotizacion")
  estado          EstadoCotizacion @default(PENDIENTE)
  fechaCotizacion DateTime @default(now()) @map("fecha_cotizacion")
  fechaVencimiento DateTime @map("fecha_vencimiento") @db.Date
  moneda          String   // ej: "USD", "ARS"
  ofertaExternaID String?  @map("oferta_externa_id")
  precioIda       Decimal  @db.Decimal(12, 2) @map("precio_ida")
  precioVuelta    Decimal  @db.Decimal(12, 2) @map("precio_vuelta")
  precioIdaYVuelta Decimal @db.Decimal(12, 2) @map("precio_ida_y_vuelta")
  impuestos       Decimal  @db.Decimal(12, 2)
  observaciones   String?
  // Hotel opcional — agregado por el vendedor después de la cotización de vuelos
  hotelId         String?  @map("hotel_id")
  hotel           Hotel?   @relation(fields: [hotelId], references: [id])
  noches          Int?     // cantidad de noches
  precioHotel     Decimal? @db.Decimal(12, 2) @map("precio_hotel") // total hotel (precioNoche * noches)
  // Atributos del producto aéreo cotizado (reintegrados del modelo original).
  // Reflejan lo que captura la calculadora de vuelos (clase, equipaje, extras).
  clase           ClaseVuelo @default(ECONOMICA)
  cantidadValijas Int      @default(0) @map("cantidad_valijas") // valijas de bodega incluidas/adicionales
  extras          String?  // servicios adicionales (seguro, selección de asiento, traslados, etc.)
  precioExtras    Decimal? @db.Decimal(12, 2) @map("precio_extras") // costo total de los extras
  reservas        Reserva[]
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")
  baja            DateTime? @map("baja")

  @@map("cotizaciones")
}

// =====================================================
// RESERVA
// =====================================================
model Reserva {
  id              String   @id @default(cuid())
  cotizacionId    String   @map("cotizacion_id")
  cotizacion      Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  clienteId       String   @map("cliente_id")
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipoReserva     TipoReserva
  montoFinal      Decimal  @db.Decimal(12, 2) @map("monto_final")
  saldoPagado     Decimal  @db.Decimal(12, 2) @default(0) @map("saldo_pagado")
  // saldoPendiente se calcula: montoFinal - saldoPagado (no se guarda)
  fechaViaje      DateTime? @map("fecha_viaje") // primera salida del primer tramo
  fechaRegreso    DateTime? @map("fecha_regreso") // última llegada
  numeroReserva   String   @unique @map("numero_reserva")
  estado          EstadoReserva @default(EN_PROCESO)
  motivoCancelacion String? @map("motivo_cancelacion")
  fechaReserva    DateTime @default(now()) @map("fecha_reserva")
  observaciones   String?
  recordatorios   Recordatorio[]
  pasajeros       Pasajero[]
  documentos      DocumentoGenerado[]
  pagos           Pago[]
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")
  baja            DateTime? @map("baja")

  @@map("reservas")
}

// =====================================================
// PASAJERO — Fase B. Modelo aparte (1‑N con Reserva), no una
// ampliación de Cliente: una reserva real de agencia puede llevar
// varios viajeros (grupo familiar) con documento propio, distintos
// del titular de la cuenta que figura en Cliente.
// =====================================================
enum TipoDocumentoIdentidad {
  DNI
  PASAPORTE
}

model Pasajero {
  id              String   @id @default(cuid())
  reservaId       String   @map("reserva_id")
  reserva         Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  nombre          String
  apellido        String
  documentoTipo   TipoDocumentoIdentidad @map("documento_tipo")
  documentoNumero String   @map("documento_numero")
  fechaNacimiento DateTime @db.Date @map("fecha_nacimiento")
  nacionalidad    String?
  esTitular       Boolean  @default(false) @map("es_titular") // true si coincide con el Cliente de la reserva
  // Asistencia especial (reintegrado del campo `discapacidad` del modelo original).
  // Se modela por pasajero porque la necesidad de asistencia es individual y debe
  // viajar en el voucher / aviso a la aerolínea.
  asistenciaEspecial Boolean @default(false) @map("asistencia_especial") // movilidad reducida, silla de ruedas, etc.
  detalleAsistencia  String? @map("detalle_asistencia") // descripción libre del tipo de asistencia requerida
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")
  baja            DateTime? @map("baja")

  @@index([reservaId])
  @@map("pasajeros")
}

// =====================================================
// DOCUMENTO GENERADO — Fase B (voucher) y Fase C (contrato), mismo
// modelo. `datosSnapshot` congela los datos al momento de emitir (no
// depende de que Cliente/Pasajero/Reserva no cambien después). Los
// campos de aceptación quedan en null/false para VOUCHER y se usan
// recién en Fase C para CONTRATO.
// =====================================================
enum TipoDocumento {
  VOUCHER
  CONTRATO
  COTIZACION
}

model DocumentoGenerado {
  id              String   @id @default(cuid())
  reservaId       String   @map("reserva_id")
  reserva         Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tipo            TipoDocumento
  version         Int      @default(1)
  url             String?  // ubicación pública del PDF/HTML servido por el back
  hash            String?  // sha256 del contenido, para integridad
  datosSnapshot   Json     @map("datos_snapshot")
  fechaEmision    DateTime @default(now()) @map("fecha_emision")
  // Fase C: registro de aceptación del contrato (sin firma digital avanzada)
  aceptado        Boolean  @default(false)
  fechaAceptacion DateTime? @map("fecha_aceptacion")
  medioAceptacion String?  @map("medio_aceptacion")

  @@index([reservaId, tipo])
  @@map("documentos_generados")
}

// =====================================================
// PAGO — Fase D. Conciliación: cada pago queda registrado individualmente
// (medio, fecha, referencia) en vez de sólo mutar `saldoPagado` a mano.
// `saldoPagado` en Reserva se mantiene como cache derivado (lo siguen
// leyendo el front y n8n) pero ahora cada cambio tiene un Pago detrás
// que lo justifica — se puede auditar de dónde salió cada peso.
// =====================================================
enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  MERCADOPAGO
  OTRO
}

model Pago {
  id             String    @id @default(cuid())
  reservaId      String    @map("reserva_id")
  reserva        Reserva   @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  monto          Decimal   @db.Decimal(12, 2)
  medioPago      MedioPago @map("medio_pago")
  referencia     String?   // nro de operación, transferencia, comprobante MP, etc.
  observaciones  String?
  fechaPago      DateTime  @default(now()) @map("fecha_pago")
  alta           DateTime  @default(now()) @map("alta")
  modificacion   DateTime  @updatedAt @map("modificacion")
  baja           DateTime? @map("baja") // anulación de un pago mal registrado

  @@index([reservaId])
  @@map("pagos")
}

// =====================================================
// ENUMS
// =====================================================
enum EstadoCotizacion {
  PENDIENTE
  ENVIADA
  ACEPTADA
  VENCIDA
}

enum TipoReserva {
  IDA
  VUELTA
  IDA_Y_VUELTA
}

// Clase/cabina del vuelo cotizado. Mapea con el parámetro travel_class de la
// API de Google Flights (1=Economy, 2=Premium economy, 3=Business, 4=First).
enum ClaseVuelo {
  ECONOMICA
  PREMIUM_ECONOMICA
  EJECUTIVA
  PRIMERA
}

// Máquina de estados explícita del ciclo de vida de la reserva (Fase E).
// EN_PROCESO: reserva creada, sin seña.
// SEÑADA: tiene un pago parcial (seña) pero no cubre el total.
// PAGADA: saldoPendiente <= 0 (cubierta totalmente).
// DOCUMENTADA: tiene voucher/contrato emitido (Fase B/C).
// EN_VIAJE: dentro de la ventana fechaViaje..fechaRegreso.
// FINALIZADA: viaje completado (terminal, salvo cancelación previa).
// CANCELADA: terminal desde cualquier estado anterior.
// Transiciones válidas centralizadas en reservas.service.ts (transicionarEstado).
enum EstadoReserva {
  EN_PROCESO
  SEÑADA
  PAGADA
  DOCUMENTADA
  EN_VIAJE
  FINALIZADA
  CANCELADA
}


model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  nombre       String
  passwordHash String    @map("password_hash")
  alta         DateTime  @default(now()) @map("alta")
  modificacion DateTime  @updatedAt @map("modificacion")
  baja         DateTime? @map("baja")

  @@map("admin_users")
}

// =====================================================
// RECORDATORIO — los manda el Flujo 3 (cron 9 AM)
// =====================================================
enum TipoRecordatorio {
  PAGO_SALDO   // 14 días antes del viaje, si saldoPendiente > 0
  CHECK_IN     // 1 día antes del viaje
  POST_VIAJE   // 1 día después del regreso (feedback)
  CLIMA        // 3 días antes (opcional)
  VOUCHER      // 1 día antes (opcional)
  CONTRATO     // inmediato, al confirmar la seña (EN_PROCESO -> SEÑADA)
}

model Recordatorio {
  id              String   @id @default(cuid())
  reservaId       String   @map("reserva_id")
  reserva         Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tipo            TipoRecordatorio
  fechaProgramada DateTime @map("fecha_programada")
  ejecutado       Boolean  @default(false)
  fechaEjecucion  DateTime? @map("fecha_ejecucion")
  resultado       String?  // texto del mensaje enviado o error
  alta            DateTime @default(now()) @map("alta")
  modificacion    DateTime @updatedAt @map("modificacion")

  @@index([fechaProgramada, ejecutado])
  @@map("recordatorios")
}

// =====================================================
// PARAMETRO SISTEMA — config / tipo de cambio / feature flags
// =====================================================
model ParametroSistema {
  clave        String   @id
  valor        String
  descripcion  String?
  modificacion DateTime @updatedAt @map("modificacion")

  @@map("parametros_sistema")
}

