# Variables del servicio "backend" en Render (plan free).
# Copiá estas claves en Render → servicio → Environment.
# Ninguna lleva comillas en el panel.

# ── Obligatorias (el proceso no arranca sin ellas) ───────────────────────────

# Supabase → Project Settings → Database → Connection string → URI.
# Usá el puerto 5432 (conexión directa), no el 6543 del pooler: las
# migraciones de Prisma necesitan conexión directa.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# Generá cada uno con:  openssl rand -hex 32
JWT_SECRET=<64 caracteres hex>
DOCS_URL_SECRET=<64 caracteres hex>

# ── Autenticación ────────────────────────────────────────────────────────────

# En producción va SÍ o SÍ en true. Con false la API queda abierta a internet.
AUTH_ENABLED=true

# La misma que cargues en n8n como variable N8N_API_KEY.
# Generala nueva:  openssl rand -hex 24
N8N_API_KEY=<clave nueva, NO la del .env local>

JWT_EXPIRES_IN=8h

# ── Red ──────────────────────────────────────────────────────────────────────

# Render inyecta PORT automáticamente. No la definas a mano.

# Dominio del frontend en Vercel. Sin esto el panel no puede llamar a la API.
# Separá por comas si hay más de uno (producción + preview).
CORS_ORIGINS=https://<tu-front>.vercel.app

# Dominio público del propio backend. Se usa para armar los enlaces firmados
# de los documentos que se mandan por WhatsApp y por correo.
PUBLIC_BASE_URL=https://stg-backend-xxxx.onrender.com

# ── Almacenamiento de documentos ─────────────────────────────────────────────

# El disco de Render free es efímero: se reinicia con cada suspensión y con
# cada redespliegue. Con estas dos variables definidas, los vouchers y
# contratos se guardan en Supabase Storage en lugar del sistema de archivos.
# Si las dejás vacías, el backend usa disco local (comportamiento de siempre,
# correcto en desarrollo).
SUPABASE_URL=https://<ref>.supabase.co
# Supabase → Settings → API → service_role. Saltea todas las reglas de
# acceso: va SOLO acá, nunca en el frontend.
SUPABASE_SERVICE_KEY=<service_role>
DOCUMENTOS_BUCKET=documentos

# Solo se usa cuando NO hay Supabase Storage configurado (desarrollo local).
DOCUMENTOS_STORAGE_DIR=storage/documentos

# ── Integración tarifaria ────────────────────────────────────────────────────

RAPIDAPI_KEY=<tu clave de RapidAPI>
RAPIDAPI_FLIGHTS_HOST=google-flights2.p.rapidapi.com

# true = no consume cuota, devuelve vuelos simulados. Útil para probar el
# despliegue sin gastar las 100 búsquedas mensuales del plan gratuito.
MOCK_FLIGHTS=false

# ── Opcional ─────────────────────────────────────────────────────────────────

# Si la definís, los PDF se generan con el servicio de PDFShift en lugar de
# Puppeteer. Solo hace falta si Chromium diera problemas en el contenedor.
# PDFSHIFT_API_KEY=

NODE_ENV=production
