    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Traduce la respuesta del back (el recordatorio, tal como quedó después\n// de registrar el intento) a un resultado simple { ok, detalle, sid }.\n// Es lo que recibe el panel cuando el envío fue manual.\nconst r = $json;\nconst resultado = String(r.resultado || '');\nif (r.yaEjecutado === true) {\n  return { json: { ok: false, recordatorioId: r.id, sid: null,\n    detalle: 'Otro proceso ya lo había tomado; no se reenvió para no duplicar el mensaje.' } };\n}\nconst ok = r.ejecutado === true && resultado.startsWith('Enviado');\nconst sid = (resultado.match(/SID (\\w+)/) || [])[1] || null;\nreturn { json: { ok, recordatorioId: r.id, sid, detalle: resultado || (ok ? 'Enviado' : 'Sin detalle') } };\n"
      },
      "id": "d90ea779-9226-4e2f-8a52-693d9f2416e0",
