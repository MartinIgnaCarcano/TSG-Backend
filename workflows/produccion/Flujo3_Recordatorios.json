    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma el WhatsApp de UN recordatorio (modo \"Run Once for Each Item\").\n// Llega desde dos lados con la misma forma (GET /api/recordatorios con la\n// reserva, el cliente y el viaje incluidos): el cron de las 9 y el webhook\n// del botón \"Enviar WhatsApp\" del panel.\n//\n// VOUCHER y CONTRATO no se programan por fecha: salen al instante por el\n// Flujo7 cuando se emite el documento. Si alguno llega acá (carga manual),\n// cae en el mensaje genérico.\nconst r = $json;\nconst rsv = r.reserva || {};\nconst cli = rsv.cliente || {};\nconst v = rsv.cotizacion?.viaje || {};\nconst ruta = (v.origen?.codigoIATA && v.destino?.codigoIATA)\n  ? `${v.origen.codigoIATA} → ${v.destino.codigoIATA}`\n  : 'tu viaje';\n// Las fechas se guardan a las 00:00 UTC: se formatean en UTC para que no\n// aparezca el día anterior.\nconst fechaViaje = rsv.fechaViaje\n  ? new Date(rsv.fechaViaje).toLocaleDateString('es-AR', { timeZone: 'UTC' })\n  : '';\nconst saldoPendiente = Math.max(0, Number(rsv.montoFinal || 0) - Number(rsv.saldoPagado || 0)).toFixed(2);\nconst nombre = cli.nombre || '';\n\n// WhatsApp exige el número internacional. En Argentina los celulares van\n// con el 9 después del 54 (+549...), y en la base hay teléfonos cargados de\n// varias formas: \"whatsapp:+549...\", \"+54 261 ...\", \"2614179824\".\nfunction normalizarTelefono(t) {\n  const crudo = String(t || '').replace(/^whatsapp:/i, '').trim();\n  if (!crudo) return '';\n  let d = crudo.replace(/[^\\d]/g, '');\n  if (crudo.startsWith('+') && !d.startsWith('54')) return '+' + d; // otro país: se respeta\n  if (d.startsWith('00')) d = d.slice(2);\n  if (d.startsWith('0')) d = d.slice(1);                 // 0261... → 261...\n  if (d.length === 10) return '+549' + d;                // 2614179824\n  if (d.startsWith('549')) return '+' + d;\n  if (d.startsWith('54')) return '+549' + d.slice(2);    // +54 261... → +549 261...\n  return '+' + d;\n}\n\nlet mensaje = '';\nswitch (r.tipo) {\n  case 'PAGO_SALDO':\n    mensaje = `🧾 *Recordatorio de pago — STG*\\n\\nHola ${nombre}, te recordamos que tenés un saldo pendiente de *USD ${saldoPendiente}* para tu reserva ${rsv.numeroReserva} (${ruta} - ${fechaViaje}).\\n\\nPara evitar la cancelación automática, regularizá el pago hasta 7 días antes del viaje. Cualquier consulta, escribinos por acá. ✈️`;\n    break;\n  case 'CHECK_IN':\n    mensaje = `✈️ *¡Se viene tu viaje!*\\n\\nHola ${nombre}, recordá hacer el check-in online de tu vuelo (${ruta} - ${fechaViaje}). La mayoría de las aerolíneas lo habilitan 24-48 horas antes.\\n\\n¡Buen viaje! 🌍`;\n    break;\n  case 'POST_VIAJE':\n    mensaje = `🎉 *¿Qué tal el viaje?*\\n\\nHola ${nombre}, esperamos que la hayas pasado increíble en ${v.destino?.nombre || 'tu destino'}. Nos encantaría saber cómo fue tu experiencia para seguir mejorando.\\n\\n¿Nos dejás un comentario o una calificación? 🙏`;\n    break;\n  case 'CLIMA':\n    mensaje = `🌤️ *Antes de viajar*\\n\\nHola ${nombre}, en unos días salís hacia ${v.destino?.nombre || 'tu destino'} (${ruta} - ${fechaViaje}). Te recomendamos revisar el pronóstico para armar la valija. ¡Cualquier duda, escribinos! 🧳`;\n    break;\n  default:\n    mensaje = `Hola ${nombre}, te escribimos desde STG sobre tu reserva ${rsv.numeroReserva}.`;\n}\n\nreturn { json: {\n  recordatorioId: r.id,\n  tipo: r.tipo,\n  telefono: normalizarTelefono(cli.telefono),\n  mensaje,\n  reservaNumero: rsv.numeroReserva,\n} };\n"
      },
