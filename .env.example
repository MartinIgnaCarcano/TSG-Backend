# =====================================================
# BASE DE DATOS
# =====================================================
# Si tenés Postgres local instalado:
DATABASE_URL="postgresql://postgres:1234@localhost:5432/STG?schema=public"

# Si usás Docker, primero levantá:
#   docker run --name stg-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=stg -p 5432:5432 -d postgres:16

# =====================================================
# SERVIDOR
# =====================================================
PORT=3001

# =====================================================
# Búsqueda de vuelos (RapidAPI google-flights2) — usado por /api/calculadora
# =====================================================
# https://rapidapi.com/DataCrawler/api/google-flights2
RAPIDAPI_KEY=
RAPIDAPI_FLIGHTS_HOST=google-flights2.p.rapidapi.com

# =====================================================
# MODOS DE DEMO
# =====================================================
# Si MOCK_FLIGHTS=true, la calculadora devuelve vuelos hardcodeados (no llama a RapidAPI)
MOCK_FLIGHTS=false

# =====================================================
# CORS — orígenes permitidos además de file:// (front vanilla) y n8n
# (server-to-server, sin header Origin). Separados por coma.
# =====================================================
# CORS_ORIGINS=http://localhost:5500,http://localhost:5173

# El bot de WhatsApp (Twilio + Groq) ya NO vive en este backend — lo
# orquesta n8n con sus propias credenciales. Ver README.md.

# =====================================================
# AUTH
# =====================================================
# Secreto para firmar los JWT del login de admins. Generá uno propio,
# por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Si AUTH_ENABLED=true, todas las rutas (salvo health y login) exigen
# Bearer JWT o x-api-key. En false (default), la API queda abierta
# como hasta ahora (modo demo).
AUTH_ENABLED=false

# API key fija para los workflows de n8n (header x-api-key), requerida
# si AUTH_ENABLED=true. Generá una propia, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
N8N_API_KEY=

# =====================================================
# DOCUMENTOS (vouchers / contratos) — Fase B/C
# =====================================================
# https://pdfshift.io — convierte el HTML de la plantilla en PDF real.
# Si se deja vacío, /reservas/:id/voucher y /reservas/:id/contrato
# funcionan igual pero en modo mock: guardan el HTML tal cual (.html)
# en vez de un PDF, para no bloquear la demo sin la key real.
PDFSHIFT_API_KEY=
# Carpeta donde se guardan los documentos generados en disco. Relativa a
# la raíz del backend. Ya no se sirve como estático público (Fase S3):
# se descargan por GET /api/documentos/:id/descargar con URL firmada.
DOCUMENTOS_STORAGE_DIR=storage/documentos

# =====================================================
# DOCUMENTOS — Fase S3: URLs firmadas (obligatorio)
# =====================================================
# Secreto para firmar (HMAC-SHA256) los links de descarga de vouchers y
# contratos, con vencimiento (Ley 25.326: esos PDFs tienen DNI y fecha de
# nacimiento). Generá uno propio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DOCS_URL_SECRET=
# Host público con el que se arman esos links (el que reciben WhatsApp/
# email). Por default, http://localhost:<PORT>.
# PUBLIC_BASE_URL=http://localhost:3001
