# En dev, dejar vacío: el proxy de Vite (vite.config.ts) ya manda /api a
# http://localhost:3001. Solo hace falta setear esto si el back corre en
# otro host/puerto (ej. demo con ngrok) o en el build de producción.
VITE_API_BASE=/api

# Base de n8n para el Flujo 6 (búsqueda externa de hoteles), llamado
# directo desde el front igual que en Hoteles.js — no pasa por el back.
VITE_N8N_BASE=http://localhost:5678
